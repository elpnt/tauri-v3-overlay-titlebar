{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "tauri-v3-overlay-titlebar",
	"version": "0.1.0",
	"identifier": "com.elpnt.tauri-v3-overlay-titlebar",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "tauri-v3-overlay-titlebar",
				"width": 800,
				"height": 600,
				"hiddenTitle": true,
				"titleBarStyle": "Overlay"
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
